# thesis-control.qls
# Local-pattern control group: SQL injection, weak cryptography, insecure randomness.

- description: Thesis control group (SQL injection, weak cryptography)

- queries: .
  from: codeql/javascript-queries

- include:
    id:
      # --- SQL injection ---
      - js/sql-injection
      # --- Weak cryptography and insecure random values ---
      - js/weak-cryptographic-algorithm
      - js/insufficient-password-hash
      - js/insufficient-key-size
      - js/insecure-randomness
      - js/biased-cryptographic-random
