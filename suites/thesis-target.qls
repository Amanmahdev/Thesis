# thesis-target.qls
# Target classes only: XSS, prototype pollution, log injection.
# Selected by query ID from the standard JavaScript pack, so a query runs

- description: Thesis target classes (XSS, prototype pollution, log injection)

- queries: .
  from: codeql/javascript-queries

- include:
    id:
      # --- Cross-site scripting (flow-dependent group) ---
      - js/xss
      - js/reflected-xss
      - js/stored-xss
      - js/xss-through-dom
      - js/xss-through-exception
      # --- Log injection (flow-dependent group) ---
      - js/log-injection
      # --- Prototype pollution (completeness-dependent group) ---
      - js/prototype-pollution
      - js/prototype-pollution-utility
      - js/prototype-polluting-assignment
